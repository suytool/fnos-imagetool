#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
PORT="${SERVICE_PORT:-3434}"

# 定位应用可执行文件：优先使用系统注入的 TRIM_APPDEST，否则回退到脚本相对路径
APP_BIN="${TRIM_APPDEST}/server/imagetool"
if [ ! -x "${APP_BIN}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    APP_BIN="${SCRIPT_DIR}/../app/server/imagetool"
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi
    fi
    # 兜底：检查端口是否被占用（进程存在但 pid 文件丢失的情况）
    if command -v ss >/dev/null 2>&1; then
        if ss -ltn 2>/dev/null | grep -q ":${PORT} "; then
            return 0
        fi
    elif command -v netstat >/dev/null 2>&1; then
        if netstat -ltn 2>/dev/null | grep -q ":${PORT} "; then
            return 0
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    if [ ! -x "${APP_BIN}" ]; then
        echo "找不到应用可执行文件: ${APP_BIN}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        return 1
    fi

    log_msg "Starting process ..."
    mkdir -p "${TRIM_PKGVAR}"
    ( PORT="${PORT}" "${APP_BIN}" >> "${LOG_FILE}" 2>&1 & echo $! > "${PID_FILE}" )
    sleep 1
    if status; then
        log_msg "Process started, pid=$(cat ${PID_FILE} 2>/dev/null)"
        return 0
    else
        log_msg "Process failed to start"
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        if check_process "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            local count=0
            while check_process "${pid}" && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
                log_msg "waiting process terminal... (${count}s/10s)"
            done
            if check_process "${pid}"; then
                kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
                sleep 1
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
